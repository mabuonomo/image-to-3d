# Hunyuan3D-2 model configuration (2mini fits comfortably in 16GB VRAM)
HUNYUAN_MODEL_ID=tencent/Hunyuan3D-2mini
HUNYUAN_SUBFOLDER=hunyuan3d-dit-v2-mini
ENABLE_TEXTURE=true

# HuggingFace cache & optional token for gated models
HF_HOME=/models/huggingface
HF_TOKEN=

# Ports
WEB_PORT=3000
WORKER_PORT=8000

# Internal URLs
WORKER_INTERNAL_URL=http://worker:8000
NEXT_PUBLIC_WORKER_URL=http://localhost:8000
