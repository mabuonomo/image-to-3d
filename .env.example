# Pipeline mode: "demo" (generates a test rigged .glb immediately) or "production" (runs local AI models)
PIPELINE_MODE=demo

# HuggingFace token (optional, needed for gated models)
HF_TOKEN=

# Ports
WEB_PORT=3000
WORKER_PORT=8000

# Internal URLs
WORKER_INTERNAL_URL=http://worker:8000
NEXT_PUBLIC_WORKER_URL=http://localhost:8000
